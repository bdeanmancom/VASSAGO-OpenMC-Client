{
  "name": "vassago-client",
  "productName": "Vassago",
  "version": "0.2.1",
  "description": "Vassago — a free, independent, open-source client compatible with Minecraft: Java Edition servers. Not affiliated with Mojang or Microsoft.",
  "license": "MIT",
  "author": "Vassago Client contributors",
  "homepage": "https://github.com/bdeanmancom/VASSAGO-OpenMC-Client",
  "main": "dist/main/main.js",
  "private": true,
  "scripts": {
    "gen:data": "node scripts/gen-blockdata.mjs",
    "build": "npm run gen:data && node scripts/build.mjs",
    "build:fast": "node scripts/build.mjs",
    "start": "npm run build && node scripts/ensure-electron.mjs && electron .",
    "dev": "node scripts/build.mjs && node scripts/ensure-electron.mjs && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run --config vitest.integration.config.ts tests/integration/session.test.ts",
    "test:e2e": "node scripts/ensure-electron.mjs && node tests/e2e/run-e2e.mjs",
    "test-server": "node scripts/test-server.mjs",
    "dist": "npm run build && electron-builder --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "make:icon": "node scripts/make-icon.mjs",
    "pack:dir": "npm run build && electron-builder --dir --publish never",
    "pretest": "node scripts/gen-blockdata.mjs --if-missing",
    "pretypecheck": "node scripts/gen-blockdata.mjs --if-missing",
    "check-server": "node scripts/check-server.mjs",
    "test:soak": "vitest run --config vitest.integration.config.ts tests/integration/soak.test.ts"
  },
  "dependencies": {
    "minecraft-data": "^3.119.0",
    "minecraft-protocol": "^1.68.0",
    "mineflayer": "^4.39.0",
    "prismarine-auth": "^3.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^39.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "playwright": "^1.49.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "live.vassago.client",
    "productName": "Vassago",
    "copyright": "Copyright © 2026 Vassago Client contributors (MIT License)",
    "asar": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "resources/gamedata/**",
      "package.json",
      "LICENSE",
      "!**/*.map",
      "!node_modules/minecraft-data/minecraft-data/data/bedrock/**",
      "node_modules/minecraft-data/minecraft-data/data/bedrock/common/**",
      "!node_modules/minecraft-data/doc/**",
      "!node_modules/**/{test,tests,docs,examples,example}/**",
      "!node_modules/**/*.{md,markdown,ts,map}",
      "node_modules/**/*.d.ts"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game",
      "icon": "build/icon.png",
      "artifactName": "Vassago-${version}-linux-${arch}.${ext}",
      "synopsis": "Open voxel client for Java Edition-compatible servers"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Vassago-${version}-windows-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Vassago"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.games",
      "icon": "build/icon.png",
      "artifactName": "Vassago-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "sign": false
    }
  },
  "engines": {
    "node": ">=20"
  }
}
